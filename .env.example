# HomeFlow Multiplatform — server environment.
# Copy to .env and replace every replace-with-* value before starting the stack.
# Generate secrets:  openssl rand -base64 32  (encryption key) / -base64 24 (passwords)
# See __docs/DOCKER.md and __docs/DEPLOYMENT.md for the authoritative reference.

# --- Hosting / TLS ----------------------------------------------------------
APP_HOSTNAME=homeflow.lan                      # LAN hostname, or the canonical *.ts.net over Tailscale
TZ=UTC

# --- Ktor server ------------------------------------------------------------
API_PORT=8080
LOG_LEVEL=info                                  # trace|debug|info|warn|error

# --- PostgreSQL: superuser (migrations only) --------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=period_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password

# --- PostgreSQL: restricted app role (Ktor runtime) — must differ from above -
POSTGRES_APP_USER=app_user
POSTGRES_APP_PASSWORD=replace-with-different-strong-password

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-strong-password
PUBLIC_KEYCLOAK_URL=https://homeflow.lan        # MUST match APP_HOSTNAME or every JWT 401s on iss
PUBLIC_KEYCLOAK_HTTP_PORT=443
PUBLIC_KEYCLOAK_REALM=homeflow
KEYCLOAK_INTERNAL_URL=http://keycloak:8080      # container-to-container (JWKS, token, admin)
KEYCLOAK_CLIENT_ID=homeflow-backend
KEYCLOAK_CLIENT_SECRET=replace-with-keycloak-generated-secret

# --- Application-layer encryption -------------------------------------------
# AES-256-GCM key, 32 bytes base64. Set ONCE and NEVER change — rotating it makes
# all encrypted notes and sex logs permanently unreadable.
APP_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# --- Rate limiting (optional; defaults shown) -------------------------------
# RATE_LIMIT_MAX=100
# RATE_LIMIT_TIME_WINDOW_MS=60000
