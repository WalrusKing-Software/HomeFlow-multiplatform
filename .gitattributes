# Enforce LF line endings across the repo (CLAUDE.md: never CRLF in the repo).
# This matters on Windows where core.autocrlf may be true.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# The Gradle wrapper script must stay LF even on Windows checkouts.
gradlew text eol=lf

# Binary assets — never normalize.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.keystore binary
*.jks binary
