# Android release signing — copy to `keystore.properties` at the repo root and fill in.
# The real keystore.properties and the .jks/.keystore file are gitignored: secrets never
# enter VCS. When this file is absent, `:app:androidApp:bundleRelease` produces an UNSIGNED
# AAB. Generate a keystore once and keep it (+ these passwords) backed up safely:
#
#   keytool -genkeypair -v -keystore homeflow-release.jks -alias homeflow \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to the repo root.
storeFile=homeflow-release.jks
storePassword=changeit
keyAlias=homeflow
keyPassword=changeit
