CREATE TABLE IF NOT EXISTS user_dashboard_preferences (
    id             TEXT NOT NULL PRIMARY KEY,
    user_id        TEXT NOT NULL REFERENCES users(id) UNIQUE,
    category_order TEXT NOT NULL,
    updated_at     TEXT NOT NULL,
    deleted_at     TEXT
);

selectByUserId:
SELECT * FROM user_dashboard_preferences WHERE user_id = :userId AND deleted_at IS NULL;

upsert:
INSERT INTO user_dashboard_preferences (id, user_id, category_order, updated_at, deleted_at)
VALUES (?, ?, ?, ?, ?)
ON CONFLICT(user_id) DO UPDATE SET category_order = excluded.category_order, updated_at = excluded.updated_at;

deleteAll:
DELETE FROM user_dashboard_preferences;
