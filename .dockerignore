.gradle
**/build/
**/bin/
.kotlin
.idea
*.iml
local.properties
.env
.env.*
!.env.example
backups/
*.apk
*.aab
*.dmg
*.msi
*.deb
*.pkg
# the exported chat transcript and any local scratch files
*.txt
